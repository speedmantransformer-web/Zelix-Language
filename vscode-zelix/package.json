{
  "name": "zelix-language",
  "displayName": "Zelix Language",
  "description": "Zelix language support: static types, generic collections, async concurrency, native builds, diagnostics, formatting, and debugging.",
  "version": "0.4.0",
  "publisher": "CloudZ",
  "icon": "images/zelix-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/speedmantransformer-web/Zelix-Language.git",
    "directory": "vscode-zelix"
  },
  "keywords": [
    "zelix",
    "language",
    "compiler",
    "interpreter",
    "debugger",
    "raylib",
    "static-types",
    "generics",
    "collections",
    "concurrency",
    "async"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:zelix",
    "onDebug:zelix"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zelix",
        "aliases": [
          "Zelix",
          "zelix"
        ],
        "extensions": [
          ".zelix"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zelix",
        "scopeName": "source.zelix",
        "path": "./syntaxes/zelix.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zelix",
        "path": "./snippets/zelix.json"
      }
    ],
    "iconThemes": [
      {
        "id": "zelix-file-icons",
        "label": "Zelix File Icons",
        "path": "./icons/zelix-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "zelix.runCurrentFile",
        "title": "Zelix: Run Current File",
        "category": "Zelix"
      },
      {
        "command": "zelix.debugCurrentFile",
        "title": "Zelix: Debug Current File",
        "category": "Zelix"
      },
      {
        "command": "zelix.compileCurrentFile",
        "title": "Zelix: Compile Current File",
        "category": "Zelix"
      },
      {
        "command": "zelix.showOptimizedIR",
        "title": "Zelix: Show Optimized IR",
        "category": "Zelix"
      },
      {
        "command": "zelix.initProject",
        "title": "Zelix: Initialize Project",
        "category": "Zelix"
      },
      {
        "command": "zelix.installPackages",
        "title": "Zelix: Install Local Packages",
        "category": "Zelix"
      }
    ],
    "configuration": {
      "title": "Zelix",
      "properties": {
        "zelix.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used when running Zelix from a source checkout or custom CLI script."
        },
        "zelix.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to zelix.py; when empty, uses a nearby source checkout or the installed Zelix CLI."
        },
        "zelix.command": {
          "type": "string",
          "default": "zelix",
          "description": "Zelix CLI executable used when no source checkout or custom CLI script is configured."
        }
      }
    },
    "debuggers": [
      {
        "type": "zelix",
        "label": "Zelix Debugger",
        "languages": ["zelix"],
        "runtime": "node",
        "program": "./debug_adapter.js",
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .zelix file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause before the first executable statement.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "zelix",
            "request": "launch",
            "name": "Debug Zelix File",
            "program": "${file}",
            "stopOnEntry": true
          }
        ]
      }
    ]
  }
}
